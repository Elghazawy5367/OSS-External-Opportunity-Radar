# Local runs only. Copy to .env (gitignored). In GitHub Actions these come from secrets.

# GitHub REST API. Injected automatically inside Actions.
# Locally optional. Search API: 30 req/min with a token, 10 req/min without
# (docs.github.com/en/rest/search/search, checked 2026-09-24); the collector paces itself.
# Core REST: 5,000 req/hr for a personal token; GITHUB_TOKEN inside Actions: 1,000 req/hr per repo
# (docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api, checked 2026-09-24).
GITHUB_TOKEN=

# Stack Exchange API key (free: https://stackapps.com/apps/oauth/register).
# Without it: 300 requests/day per IP. With it: 10,000 requests/day.
# In Actions: repo secret STACKEXCHANGE_KEY.
STACKEXCHANGE_KEY=

# Hacker News (Algolia) needs no key.

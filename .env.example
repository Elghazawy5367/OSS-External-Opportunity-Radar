# Local runs only. Copy to .env (gitignored). In GitHub Actions these come from repo SECRETS
# (never from repo Variables: those are stored in plain text).

# GitHub REST API token used by the GitHub collector.
# - In Actions the workflow passes repo secret OSS_RADAR_GITHUB_PAT here and falls back to the
#   automatic GITHUB_TOKEN if that secret is empty. The search API only needs public data, so a
#   personal access token with NO scopes is enough.
# - Locally optional. Search API: 30 req/min with a token, 10 req/min without
#   (docs.github.com/en/rest/search/search, checked 2026-09-24); the collector paces itself.
# - Core REST: 5,000 req/hr for a personal token; GITHUB_TOKEN inside Actions: 1,000 req/hr per repo
#   (docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api, checked 2026-09-24).
GITHUB_TOKEN=

# Stack Exchange API key (free: https://stackapps.com/apps/oauth/register).
# Without it: 300 requests/day per IP. With it: 10,000 requests/day.
# It identifies your registered app and carries that quota, so keep it out of the repo and out of logs.
# In Actions: repo secret STACKEXCHANGE_KEY.
STACKEXCHANGE_KEY=

# Optional: write reports to (and read history from) another folder instead of data/reports/,
# e.g. a scratch copy for smoke tests.
# OSS_RADAR_REPORTS_DIR=

# Hacker News (Algolia) needs no key.
